<Window x:Class="XiboClient.Integration.Nexmosphere.NexmosphereSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XiboClient.Integration.Nexmosphere"
        mc:Ignorable="d"
        Title="Nexmosphere Settings" Height="450" Width="800">
    <Grid>
        <CheckBox x:Name="checkBoxIsEnabled" Content="Enable Nexmosphere?" HorizontalAlignment="Left" Margin="79,37,0,0" VerticalAlignment="Top" Checked="checkBoxIsEnabled_Checked" Unchecked="checkBoxIsEnabled_Unchecked" />
        <TextBox x:Name="textBoxPortName" HorizontalAlignment="Left" Margin="79,14,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="textBoxPortName_TextChanged"/>
        <Label Content="Port Name" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Button x:Name="buttonStart" Content="Start" HorizontalAlignment="Left" Margin="686,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.598,0.135" Click="buttonStart_Click" Width="104"/>
        <Button x:Name="buttonStop" Content="Stop" HorizontalAlignment="Left" Margin="686,34,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.598,0.135" Click="buttonStop_Click" Width="104"/>
        <DataGrid x:Name="dataGrid" Margin="10,69,10,10">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Path=DateTime}" Width="170" IsReadOnly="True" Header="Date"/>
                <DataGridTextColumn Binding="{Binding Path=IsValid}" Width="50" IsReadOnly="True" Header="Valid?"/>
                <DataGridTextColumn Binding="{Binding Path=Type}" Width="50" IsReadOnly="True" Header="Type"/>
                <DataGridTextColumn Binding="{Binding Path=Address}" Width="70" IsReadOnly="True" Header="Address"/>
                <DataGridTextColumn Binding="{Binding Path=Command}" Width="70" IsReadOnly="True" Header="Command"/>
                <DataGridTextColumn Binding="{Binding Path=WebHookTriggerCode}" Width="150" IsReadOnly="True" Header="Webhook Trigger Code"/>
                <DataGridTextColumn Binding="{Binding Path=Raw}" Width="300" IsReadOnly="True" Header="Raw">
                    <DataGridTextColumn.ElementStyle>
                        <Style>
                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <CheckBox x:Name="checkboxTriggerWebHook" Content="Trigger Web Hook?" HorizontalAlignment="Left" Margin="243,37,0,0" VerticalAlignment="Top" Checked="checkboxTriggerWebHook_Checked" Unchecked="checkboxTriggerWebHook_Unchecked"/>

    </Grid>
</Window>
